# Source-free published native v1 compatibility vectors are test data, not
# local audit/verification output.
!/tests/fixtures/
!/tests/fixtures/native-v1/
!/tests/fixtures/native-v1/audit.json
!/tests/fixtures/native-v1/verification.json

