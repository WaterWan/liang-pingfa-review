{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/native-edit-intent/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "created_at",
    "audit_binding",
    "operations",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "liang-pingfa/native-edit-intent/v2"
    },
    "intent_id": {
      "$ref": "#/$defs/intentId"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "audit_binding": {
      "$ref": "#/$defs/auditBinding"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/translate"
          },
          {
            "$ref": "#/$defs/delete"
          },
          {
            "$ref": "#/$defs/marker"
          }
        ]
      }
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bits": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "intentId": {
      "type": "string",
      "pattern": "^native-intent-[a-f0-9]{32}$"
    },
    "auditId": {
      "type": "string",
      "pattern": "^native-audit-[a-f0-9]{32}$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^native-target-[a-f0-9]{24}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^native-operation-[a-f0-9]{24}$"
    },
    "auditBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_id",
        "audit_integrity_sha256",
        "audit_schema_version"
      ],
      "properties": {
        "audit_id": {
          "$ref": "#/$defs/auditId"
        },
        "audit_integrity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audit_schema_version": {
          "const": "liang-pingfa/native-audit/v2"
        }
      }
    },
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/bits"
      }
    },
    "translate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "target_id",
        "delta"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/operationId"
        },
        "kind": {
          "const": "translate_dbtext"
        },
        "target_id": {
          "$ref": "#/$defs/targetId"
        },
        "delta": {
          "$ref": "#/$defs/vector"
        }
      }
    },
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "target_id"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/operationId"
        },
        "kind": {
          "const": "delete_auxiliary_overlay_text"
        },
        "target_id": {
          "$ref": "#/$defs/targetId"
        }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "position"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/operationId"
        },
        "kind": {
          "const": "create_review_marker"
        },
        "position": {
          "$ref": "#/$defs/vector"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
