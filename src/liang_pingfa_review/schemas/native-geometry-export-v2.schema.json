{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/native-geometry-export/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "binding",
    "document",
    "owners",
    "containers",
    "entities",
    "portable_prewrite_projection",
    "portable_prewrite_projection_digest",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "liang-pingfa/native-geometry-export/v2"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "document": {
      "$ref": "#/$defs/document"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2001,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/handle"
      }
    },
    "containers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2001,
      "items": {
        "$ref": "#/$defs/container"
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "portable_prewrite_projection": {
      "$ref": "#/$defs/portablePrewriteProjection"
    },
    "portable_prewrite_projection_digest": {
      "$ref": "#/$defs/sha256"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[0-9A-F]+$"
    },
    "bits": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "portablePrewriteProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ordered_entity_digest",
        "container_order_digest",
        "geometry_digest",
        "protected_semantic_digest",
        "table_state_digest",
        "layout_state_digest",
        "block_state_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "liang-pingfa/portable-prewrite-projection/v2"
        },
        "ordered_entity_digest": {
          "$ref": "#/$defs/sha256"
        },
        "container_order_digest": {
          "$ref": "#/$defs/sha256"
        },
        "geometry_digest": {
          "$ref": "#/$defs/sha256"
        },
        "protected_semantic_digest": {
          "$ref": "#/$defs/sha256"
        },
        "table_state_digest": {
          "$ref": "#/$defs/sha256"
        },
        "layout_state_digest": {
          "$ref": "#/$defs/sha256"
        },
        "block_state_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sessionId": {
      "type": "string",
      "pattern": "^native-session-[a-f0-9]{32}$"
    },
    "protocolVersion": {
      "const": "liang-pingfa/native-bridge/v1"
    },
    "capability": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9._/-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sha256",
        "byte_size",
        "path_fingerprint",
        "file_identity_fingerprint",
        "dwg_header_signature"
      ],
      "properties": {
        "format": {
          "const": "DWG"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "path_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "file_identity_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "dwg_header_signature": {
          "type": "string",
          "pattern": "^AC[0-9A-Z]{4}$"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z._-]+$"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z._-]+$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "release",
        "runtime",
        "mode"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z._-]+$"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "mode": {
          "const": "full_host"
        }
      }
    },
    "processBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "windows_session_id",
        "instance_fingerprint",
        "creation_time_100ns",
        "executable_fingerprint"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "windows_session_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "instance_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "creation_time_100ns": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "executable_fingerprint": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "const": "unavailable"
            }
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "protocol_version",
        "protocol_major",
        "protocol_minor",
        "host",
        "process",
        "adapter",
        "plugin",
        "capabilities",
        "session_binding_digest",
        "stable_host_binding_digest",
        "document_binding_digest",
        "session_schema_version"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/sessionId"
        },
        "protocol_version": {
          "$ref": "#/$defs/protocolVersion"
        },
        "protocol_major": {
          "const": 1
        },
        "protocol_minor": {
          "const": 0
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "process": {
          "$ref": "#/$defs/processBinding"
        },
        "adapter": {
          "$ref": "#/$defs/adapter"
        },
        "plugin": {
          "$ref": "#/$defs/plugin"
        },
        "capabilities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "session_binding_digest": {
          "$ref": "#/$defs/sha256"
        },
        "stable_host_binding_digest": {
          "$ref": "#/$defs/sha256"
        },
        "document_binding_digest": {
          "$ref": "#/$defs/sha256"
        },
        "session_schema_version": {
          "const": "liang-pingfa/native-bridge-session/v2"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_instance_fingerprint",
        "revision_fingerprint",
        "ordered_entity_digest",
        "container_order_digest",
        "complete_geometry_digest",
        "protected_state_digest",
        "protected_order_digest",
        "table_state_digest",
        "layout_state_digest",
        "block_state_digest",
        "document_state_digest",
        "marker_layer_fingerprint",
        "marker_style_fingerprint"
      ],
      "properties": {
        "database_instance_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "revision_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "ordered_entity_digest": {
          "$ref": "#/$defs/sha256"
        },
        "container_order_digest": {
          "$ref": "#/$defs/sha256"
        },
        "complete_geometry_digest": {
          "$ref": "#/$defs/sha256"
        },
        "protected_state_digest": {
          "$ref": "#/$defs/sha256"
        },
        "protected_order_digest": {
          "$ref": "#/$defs/sha256"
        },
        "table_state_digest": {
          "$ref": "#/$defs/sha256"
        },
        "layout_state_digest": {
          "$ref": "#/$defs/sha256"
        },
        "block_state_digest": {
          "$ref": "#/$defs/sha256"
        },
        "document_state_digest": {
          "$ref": "#/$defs/sha256"
        },
        "marker_layer_fingerprint": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "marker_style_fingerprint": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "space": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "layout_handle",
            "block_handle"
          ],
          "properties": {
            "kind": {
              "const": "modelspace"
            },
            "layout_handle": {
              "$ref": "#/$defs/handle"
            },
            "block_handle": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "layout_handle",
            "block_handle"
          ],
          "properties": {
            "kind": {
              "const": "paperspace"
            },
            "layout_handle": {
              "$ref": "#/$defs/handle"
            },
            "block_handle": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "layout_handle",
            "block_handle"
          ],
          "properties": {
            "kind": {
              "const": "block"
            },
            "layout_handle": {
              "type": "null"
            },
            "block_handle": {
              "$ref": "#/$defs/handle"
            }
          }
        }
      ]
    },
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/bits"
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/vector"
        },
        "maximum": {
          "$ref": "#/$defs/vector"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/vector"
        },
        "end": {
          "$ref": "#/$defs/vector"
        }
      }
    },
    "overlayEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_content",
        "left_panel",
        "corresponding_right_absent",
        "visible_interference",
        "unsupported_data"
      ],
      "properties": {
        "unique_content": {
          "type": "boolean"
        },
        "left_panel": {
          "type": "boolean"
        },
        "corresponding_right_absent": {
          "type": "boolean"
        },
        "visible_interference": {
          "type": "boolean"
        },
        "unsupported_data": {
          "type": "boolean"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_handle",
        "space",
        "block_path",
        "physical_slot_count"
      ],
      "properties": {
        "owner_handle": {
          "$ref": "#/$defs/handle"
        },
        "space": {
          "$ref": "#/$defs/space"
        },
        "block_path": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/handle"
          }
        },
        "physical_slot_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000001,
          "description": "Erased-inclusive physical slot extent. It exposes no erased entity identity or payload."
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "native_type",
        "owner_handle",
        "space",
        "block_path",
        "sequence_index",
        "layer",
        "text",
        "style",
        "height",
        "rotation",
        "position",
        "bounds",
        "segments",
        "overlay_evidence",
        "geometry_fingerprint",
        "opaque_state_digest"
      ],
      "properties": {
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "native_type": {
          "enum": [
            "DBTEXT",
            "LINE",
            "LWPOLYLINE",
            "OPAQUE"
          ]
        },
        "owner_handle": {
          "$ref": "#/$defs/handle"
        },
        "space": {
          "$ref": "#/$defs/space"
        },
        "block_path": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/handle"
          }
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "layer": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096,
              "description": "Canonical NFC text. The 4096 Unicode-code-point bound is enforced before NFC normalization."
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "$ref": "#/$defs/bits"
        },
        "rotation": {
          "$ref": "#/$defs/bits"
        },
        "position": {
          "$ref": "#/$defs/vector"
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "segments": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "overlay_evidence": {
          "$ref": "#/$defs/overlayEvidence"
        },
        "geometry_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "opaque_state_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
