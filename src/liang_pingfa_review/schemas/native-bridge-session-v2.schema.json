{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/native-bridge-session/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "created_at",
    "expires_at",
    "monotonic_clock",
    "monotonic_boot_id",
    "monotonic_issued",
    "monotonic_expires",
    "mode",
    "pid",
    "windows_session_id",
    "process",
    "pipe_name",
    "client_nonce",
    "challenge",
    "bridge_nonce",
    "challenge_response",
    "adapter",
    "plugin",
    "host",
    "current_document",
    "capabilities",
    "integrity",
    "config_schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "liang-pingfa/native-bridge-session/v2"
    },
    "session_id": {
      "$ref": "#/$defs/sessionId"
    },
    "created_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "monotonic_clock": {
      "const": "windows-gettickcount64-ms/v1"
    },
    "monotonic_boot_id": {
      "$ref": "#/$defs/bootId"
    },
    "monotonic_issued": {
      "$ref": "#/$defs/uptimeMilliseconds"
    },
    "monotonic_expires": {
      "$ref": "#/$defs/uptimeMilliseconds"
    },
    "mode": {
      "const": "read_only"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "windows_session_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "process": {
      "$ref": "#/$defs/process"
    },
    "pipe_name": {
      "type": "string",
      "pattern": "^\\\\\\\\\\.\\\\pipe\\\\liang-pingfa-native-[A-Za-z0-9_-]{16,128}$"
    },
    "client_nonce": {
      "$ref": "#/$defs/nonce"
    },
    "challenge": {
      "$ref": "#/$defs/nonce"
    },
    "bridge_nonce": {
      "$ref": "#/$defs/nonce"
    },
    "challenge_response": {
      "$ref": "#/$defs/sha256"
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "plugin": {
      "$ref": "#/$defs/plugin"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "current_document": {
      "$ref": "#/$defs/document"
    },
    "capabilities": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "config_schema_version": {
      "const": "liang-pingfa/native-adapter-config/v2"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "bootId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "uptimeMilliseconds": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,19})$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^native-session-[a-f0-9]{32}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "capability": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9._/-]*$"
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_fingerprint",
        "creation_time_100ns",
        "executable_fingerprint"
      ],
      "properties": {
        "instance_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "creation_time_100ns": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "executable_fingerprint": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "const": "unavailable"
            }
          ]
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z._-]+$"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z._-]+$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "release",
        "runtime",
        "mode"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z._-]+$"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "mode": {
          "enum": [
            "full_host",
            "core_console"
          ]
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saved",
        "path_fingerprint",
        "file_identity_fingerprint",
        "sha256",
        "byte_size",
        "dwg_header_signature",
        "database_instance_fingerprint",
        "revision_fingerprint"
      ],
      "properties": {
        "saved": {
          "const": true
        },
        "path_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "file_identity_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "dwg_header_signature": {
          "type": "string",
          "pattern": "^AC[0-9A-Z]{4}$"
        },
        "database_instance_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "revision_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
