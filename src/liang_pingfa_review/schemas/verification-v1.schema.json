{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/verification/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id",
    "created_at",
    "audit_binding",
    "plan_binding",
    "output",
    "output_binding",
    "expected_after",
    "actual_after",
    "operation_results",
    "passed",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "liang-pingfa/verification/v1" },
    "verification_id": { "$ref": "#/$defs/verificationId" },
    "created_at": { "$ref": "#/$defs/utcTimestamp" },
    "audit_binding": { "$ref": "#/$defs/auditBinding" },
    "plan_binding": { "$ref": "#/$defs/planBinding" },
    "output": { "$ref": "#/$defs/output" },
    "output_binding": { "$ref": "#/$defs/outputBinding" },
    "expected_after": { "$ref": "#/$defs/state" },
    "actual_after": { "$ref": "#/$defs/state" },
    "operation_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/operationResult" }
    },
    "passed": { "const": true },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "verificationId": {
      "type": "string",
      "pattern": "^verification-[0-9a-f]{32}$"
    },
    "auditId": {
      "type": "string",
      "pattern": "^audit-[0-9a-f]{32}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^plan-[0-9a-f]{32}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^operation-[0-9a-f]{24}$"
    },
    "entityType": {
      "enum": ["TEXT", "LINE", "LWPOLYLINE", "INSERT", "DIMENSION", "HATCH"]
    },
    "layout": {
      "enum": ["modelspace", "paperspace", "block"]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "auditBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_id", "audit_integrity_sha256"],
      "properties": {
        "audit_id": { "$ref": "#/$defs/auditId" },
        "audit_integrity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "planBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_integrity_sha256"],
      "properties": {
        "plan_id": { "$ref": "#/$defs/planId" },
        "plan_integrity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "dwg_header_signature", "version_mapping"],
      "properties": {
        "format": { "const": "DWG" },
        "dwg_header_signature": { "const": "AC1032" },
        "version_mapping": { "const": "AC1032/R2018" }
      }
    },
    "outputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sha256",
        "byte_size",
        "path_fingerprint",
        "file_identity_fingerprint",
        "dwg_header_signature",
        "version_mapping",
        "verified_at"
      ],
      "properties": {
        "format": { "const": "DWG" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_size": { "type": "integer", "minimum": 0 },
        "path_fingerprint": { "$ref": "#/$defs/sha256" },
        "file_identity_fingerprint": { "$ref": "#/$defs/sha256" },
        "dwg_header_signature": { "const": "AC1032" },
        "version_mapping": { "const": "AC1032/R2018" },
        "verified_at": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "entityTypeCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "count"],
      "properties": {
        "entity_type": { "$ref": "#/$defs/entityType" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "layerCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_fingerprint", "count"],
      "properties": {
        "layer_fingerprint": { "$ref": "#/$defs/sha256" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "layoutCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "count"],
      "properties": {
        "layout": { "$ref": "#/$defs/layout" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_manifest_digest",
        "content_multiset_digest",
        "entity_order_manifest_digest",
        "non_target_manifest_digest",
        "paired_right_panel_digest",
        "bounds_fingerprint",
        "bounds_has_data",
        "layer_manifest_digest",
        "table_style_manifest_digest",
        "header_manifest_digest",
        "raw_header_manifest_digest",
        "objects_manifest_digest",
        "classes_manifest_digest",
        "raw_classes_manifest_digest",
        "raw_classes_multiset_digest",
        "raw_classes_record_count",
        "acdsdata_manifest_digest",
        "raw_section_structure_digest",
        "entity_type_counts",
        "layer_counts",
        "layout_counts"
      ],
      "properties": {
        "full_manifest_digest": { "$ref": "#/$defs/sha256" },
        "content_multiset_digest": { "$ref": "#/$defs/sha256" },
        "entity_order_manifest_digest": { "$ref": "#/$defs/sha256" },
        "non_target_manifest_digest": { "$ref": "#/$defs/sha256" },
        "paired_right_panel_digest": { "$ref": "#/$defs/sha256" },
        "bounds_fingerprint": { "$ref": "#/$defs/sha256" },
        "bounds_has_data": { "type": "boolean" },
        "layer_manifest_digest": { "$ref": "#/$defs/sha256" },
        "table_style_manifest_digest": { "$ref": "#/$defs/sha256" },
        "header_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_header_manifest_digest": { "$ref": "#/$defs/sha256" },
        "objects_manifest_digest": { "$ref": "#/$defs/sha256" },
        "classes_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_classes_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_classes_multiset_digest": { "$ref": "#/$defs/sha256" },
        "raw_classes_record_count": { "type": "integer", "minimum": 0 },
        "acdsdata_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_section_structure_digest": { "$ref": "#/$defs/sha256" },
        "entity_type_counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/entityTypeCount" }
        },
        "layer_counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/layerCount" }
        },
        "layout_counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/layoutCount" }
        }
      }
    },
    "operationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "target_absent",
        "content_fingerprint_delta",
        "no_added_entities",
        "non_target_manifest_preserved",
        "paired_right_panel_preserved",
        "re_audit_overlay_condition_cleared"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/operationId" },
        "target_absent": { "const": true },
        "content_fingerprint_delta": { "const": -1 },
        "no_added_entities": { "const": true },
        "non_target_manifest_preserved": { "const": true },
        "paired_right_panel_preserved": { "const": true },
        "re_audit_overlay_condition_cleared": { "const": true }
      }
    }
  }
}
