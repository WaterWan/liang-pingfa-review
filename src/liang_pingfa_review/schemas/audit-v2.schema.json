{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/audit/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "created_at",
    "expires_at",
    "scope",
    "source",
    "toolchain",
    "conversion",
    "inventory",
    "fingerprints",
    "findings",
    "audited_targets",
    "topology_assessment",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "liang-pingfa/audit/v2" },
    "audit_id": { "$ref": "#/$defs/auditId" },
    "created_at": { "$ref": "#/$defs/utcTimestamp" },
    "expires_at": { "$ref": "#/$defs/utcTimestamp" },
    "scope": { "const": "representation-and-readability-only" },
    "source": { "$ref": "#/$defs/source" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "conversion": { "$ref": "#/$defs/conversion" },
    "inventory": { "$ref": "#/$defs/inventory" },
    "fingerprints": { "$ref": "#/$defs/fingerprints" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/overlayFinding" }
    },
    "audited_targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/auditedTarget" }
    },
    "topology_assessment": { "$ref": "#/$defs/topologyAssessment" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "auditId": {
      "type": "string",
      "pattern": "^audit-[0-9a-f]{32}$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^finding-[0-9a-f]{24}$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^target-[0-9a-f]{24}$"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^(?:chain|support|span)-[0-9a-f]{24}$"
    },
    "chainId": {
      "type": "string",
      "pattern": "^chain-[0-9a-f]{24}$"
    },
    "supportId": {
      "type": "string",
      "pattern": "^support-[0-9a-f]{24}$"
    },
    "spanId": {
      "type": "string",
      "pattern": "^span-[0-9a-f]{24}$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^trace-[0-9a-f]{24}$"
    },
    "handle": {
      "type": "string",
      "pattern": "^[0-9A-F]+$"
    },
    "entityType": {
      "enum": ["TEXT", "LINE", "LWPOLYLINE", "INSERT", "DIMENSION", "HATCH"]
    },
    "layout": {
      "enum": ["modelspace", "paperspace", "block"]
    },
    "sourceTopic": {
      "enum": [
        "平面与截面表达、集中与原位作用域",
        "平面与截面综合阅读"
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sha256",
        "byte_size",
        "path_fingerprint",
        "file_identity_fingerprint",
        "dwg_header_signature",
        "version_mapping"
      ],
      "properties": {
        "format": { "const": "DWG" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_size": { "type": "integer", "minimum": 0 },
        "path_fingerprint": { "$ref": "#/$defs/sha256" },
        "file_identity_fingerprint": { "$ref": "#/$defs/sha256" },
        "dwg_header_signature": { "const": "AC1032" },
        "version_mapping": { "const": "AC1032/R2018" }
      }
    },
    "toolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oda_file_converter", "ezdxf", "application"],
      "properties": {
        "oda_file_converter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": { "version": { "const": "27.1.0" } }
        },
        "ezdxf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": { "version": { "const": "1.4.4" } }
        },
        "application": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intermediary_format",
        "output_version",
        "isolated_staging",
        "recursion",
        "audit_mode"
      ],
      "properties": {
        "intermediary_format": { "const": "DXF" },
        "output_version": { "const": "AC1032" },
        "isolated_staging": { "const": true },
        "recursion": { "const": 0 },
        "audit_mode": { "const": 1 }
      }
    },
    "manifestEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "entity_type",
        "layout",
        "sequence_index",
        "container_fingerprint",
        "owner_fingerprint",
        "layer_fingerprint",
        "identity_fingerprint",
        "content_fingerprint",
        "entity_visible",
        "layer_visible",
        "entity_transparency",
        "layer_transparency"
      ],
      "properties": {
        "handle": { "$ref": "#/$defs/handle" },
        "entity_type": { "$ref": "#/$defs/entityType" },
        "layout": { "$ref": "#/$defs/layout" },
        "sequence_index": { "type": "integer", "minimum": 0 },
        "container_fingerprint": { "$ref": "#/$defs/sha256" },
        "owner_fingerprint": { "$ref": "#/$defs/sha256" },
        "layer_fingerprint": { "$ref": "#/$defs/sha256" },
        "identity_fingerprint": { "$ref": "#/$defs/sha256" },
        "content_fingerprint": { "$ref": "#/$defs/sha256" },
        "entity_visible": { "type": "boolean" },
        "layer_visible": { "type": "boolean" },
        "entity_transparency": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "layer_transparency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "entityTypeCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "count"],
      "properties": {
        "entity_type": { "$ref": "#/$defs/entityType" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "layerCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_fingerprint", "count"],
      "properties": {
        "layer_fingerprint": { "$ref": "#/$defs/sha256" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "layoutCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "count"],
      "properties": {
        "layout": { "$ref": "#/$defs/layout" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_manifest",
        "entity_type_counts",
        "layer_counts",
        "layout_counts",
        "entity_order_manifest_digest",
        "layer_manifest_digest",
        "table_style_manifest_digest",
        "header_manifest_digest",
        "raw_header_manifest_digest",
        "objects_manifest_digest",
        "classes_manifest_digest",
        "raw_classes_manifest_digest",
        "raw_classes_multiset_digest",
        "raw_classes_record_count",
        "acdsdata_manifest_digest",
        "raw_section_structure_digest"
      ],
      "properties": {
        "entity_manifest": {
          "type": "array",
          "items": { "$ref": "#/$defs/manifestEntity" }
        },
        "entity_type_counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/entityTypeCount" }
        },
        "layer_counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/layerCount" }
        },
        "layout_counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/layoutCount" }
        },
        "entity_order_manifest_digest": { "$ref": "#/$defs/sha256" },
        "layer_manifest_digest": { "$ref": "#/$defs/sha256" },
        "table_style_manifest_digest": { "$ref": "#/$defs/sha256" },
        "header_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_header_manifest_digest": { "$ref": "#/$defs/sha256" },
        "objects_manifest_digest": { "$ref": "#/$defs/sha256" },
        "classes_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_classes_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_classes_multiset_digest": { "$ref": "#/$defs/sha256" },
        "raw_classes_record_count": { "type": "integer", "minimum": 0 },
        "acdsdata_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_section_structure_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_manifest_digest",
        "content_multiset_digest",
        "entity_order_manifest_digest",
        "non_target_manifest_digest",
        "paired_right_panel_digest",
        "bounds_fingerprint",
        "bounds_has_data"
      ],
      "properties": {
        "full_manifest_digest": { "$ref": "#/$defs/sha256" },
        "content_multiset_digest": { "$ref": "#/$defs/sha256" },
        "entity_order_manifest_digest": { "$ref": "#/$defs/sha256" },
        "non_target_manifest_digest": { "$ref": "#/$defs/sha256" },
        "paired_right_panel_digest": { "$ref": "#/$defs/sha256" },
        "bounds_fingerprint": { "$ref": "#/$defs/sha256" },
        "bounds_has_data": { "type": "boolean" }
      }
    },
    "overlayFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "status",
        "object_position",
        "field",
        "visible_evidence",
        "reasoning",
        "source_topics",
        "unreadable_parts",
        "next_step",
        "actionability",
        "target_id"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/findingId" },
        "status": { "enum": ["一致", "疑似不一致", "证据不足"] },
        "object_position": {
          "enum": [
            "左侧对应区域",
            "右侧对应区域",
            "辅助覆盖候选区域",
            "未建立面板对应关系",
            "未发现可操作对象"
          ]
        },
        "field": { "const": "字段分类与位置绑定" },
        "visible_evidence": {
          "enum": [
            "已确认辅助覆盖干扰",
            "对应区域未见辅助覆盖",
            "面板或干扰证据不足",
            "未见可操作辅助覆盖"
          ]
        },
        "reasoning": {
          "enum": [
            "辅助覆盖阻断字段分类或位置绑定",
            "对应区域表示可读且位置可绑定",
            "不猜测缺失的面板或干扰关系",
            "未建立可修改的精确目标"
          ]
        },
        "source_topics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceTopic" }
        },
        "unreadable_parts": {
          "enum": ["受覆盖字段和引出关系", "无", "面板对应关系或干扰范围"]
        },
        "next_step": {
          "enum": [
            "生成受控删除计划",
            "保持只读结论",
            "补充完整可读视图后重新审计"
          ]
        },
        "actionability": { "type": "boolean" },
        "target_id": {
          "oneOf": [
            { "$ref": "#/$defs/targetId" },
            { "type": "null" }
          ]
        }
      }
    },
    "auditedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "finding_id",
        "handle",
        "entity_type",
        "layout",
        "identity_fingerprint",
        "content_fingerprint",
        "profile",
        "unique_content_fingerprint",
        "unsupported_data",
        "left_panel_evidence",
        "corresponding_right_absent",
        "visible_interference",
        "panel_evidence_fingerprint"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/targetId" },
        "finding_id": { "$ref": "#/$defs/findingId" },
        "handle": { "$ref": "#/$defs/handle" },
        "entity_type": { "const": "TEXT" },
        "layout": { "const": "modelspace" },
        "identity_fingerprint": { "$ref": "#/$defs/sha256" },
        "content_fingerprint": { "$ref": "#/$defs/sha256" },
        "profile": { "const": "auxiliary-overlay-text-delete/v1" },
        "unique_content_fingerprint": { "const": true },
        "unsupported_data": { "const": false },
        "left_panel_evidence": { "const": true },
        "corresponding_right_absent": { "const": true },
        "visible_interference": { "const": true },
        "panel_evidence_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "topologyFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "category",
        "status",
        "object_position",
        "field",
        "visible_evidence",
        "reasoning",
        "source_topics",
        "unreadable_parts",
        "next_step",
        "actionability",
        "target_id",
        "trace_ids"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/findingId" },
        "category": {
          "enum": [
            "support_upper_annotation",
            "span_lower_annotation",
            "topology"
          ]
        },
        "status": { "enum": ["一致", "疑似不一致", "证据不足"] },
        "object_position": {
          "enum": ["支座上部原位注写", "跨中下部原位注写", "梁图拓扑"]
        },
        "field": { "const": "原位注写语义位置" },
        "visible_evidence": {
          "enum": [
            "已建立唯一拓扑位置",
            "位置与已建立拓扑不相容",
            "拓扑或标注证据不足"
          ]
        },
        "reasoning": {
          "enum": [
            "角色、文本边界和唯一拓扑目标一致",
            "角色、文本边界或引出线与唯一拓扑目标不相容",
            "不以图层、距离或最近对象推断拓扑归属"
          ]
        },
        "source_topics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceTopic" }
        },
        "unreadable_parts": {
          "enum": ["无", "拓扑或标注位置证据"]
        },
        "next_step": {
          "enum": ["保持只读结论", "补充完整可读视图后重新审计"]
        },
        "actionability": { "const": false },
        "target_id": { "type": "null" },
        "trace_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/traceId" }
        }
      }
    },
    "topologyTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "entity_handle",
        "identity_fingerprint",
        "content_fingerprint",
        "role",
        "token_equality_established",
        "chain_id",
        "support_id",
        "span_id",
        "target_provenance_id"
      ],
      "properties": {
        "trace_id": { "$ref": "#/$defs/traceId" },
        "entity_handle": { "$ref": "#/$defs/handle" },
        "identity_fingerprint": { "$ref": "#/$defs/sha256" },
        "content_fingerprint": { "$ref": "#/$defs/sha256" },
        "role": {
          "enum": [
            "beam_edges",
            "beam_ids",
            "support_geometry",
            "support_upper_annotations",
            "span_lower_annotations",
            "leaders",
            "ambiguity"
          ]
        },
        "token_equality_established": { "type": "boolean" },
        "chain_id": {
          "oneOf": [
            { "$ref": "#/$defs/chainId" },
            { "type": "null" }
          ]
        },
        "support_id": {
          "oneOf": [
            { "$ref": "#/$defs/supportId" },
            { "type": "null" }
          ]
        },
        "span_id": {
          "oneOf": [
            { "$ref": "#/$defs/spanId" },
            { "type": "null" }
          ]
        },
        "target_provenance_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^target-[0-9a-f]{24}$"
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "support_id": { "type": "string" },
              "span_id": { "type": "string" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": { "const": "beam_edges" }
            }
          },
          "then": {
            "properties": {
              "support_id": { "type": "null" },
              "span_id": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": { "const": "beam_ids" }
            }
          },
          "then": {
            "properties": {
              "chain_id": { "$ref": "#/$defs/chainId" },
              "support_id": { "type": "null" },
              "span_id": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "support_geometry"
              }
            }
          },
          "then": {
            "properties": {
              "span_id": { "type": "null" }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "support_id": { "type": "string" }
                  }
                },
                "then": {
                  "properties": {
                    "chain_id": { "$ref": "#/$defs/chainId" }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "chain_id": { "type": "string" }
                  }
                },
                "then": {
                  "properties": {
                    "support_id": { "$ref": "#/$defs/supportId" }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "role": { "const": "support_upper_annotations" }
            }
          },
          "then": {
            "properties": {
              "chain_id": { "$ref": "#/$defs/chainId" },
              "support_id": { "$ref": "#/$defs/supportId" },
              "span_id": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": { "const": "span_lower_annotations" }
            }
          },
          "then": {
            "properties": {
              "chain_id": { "$ref": "#/$defs/chainId" },
              "support_id": { "type": "null" },
              "span_id": { "$ref": "#/$defs/spanId" }
            }
          }
        }
      ]
    },
    "topologySupportRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_id", "support_geometry_trace_id"],
      "properties": {
        "support_id": { "$ref": "#/$defs/supportId" },
        "support_geometry_trace_id": { "$ref": "#/$defs/traceId" }
      }
    },
    "topologySpanRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_id", "left_support_id", "right_support_id"],
      "properties": {
        "span_id": { "$ref": "#/$defs/spanId" },
        "left_support_id": { "$ref": "#/$defs/supportId" },
        "right_support_id": { "$ref": "#/$defs/supportId" }
      }
    },
    "topologyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "supports", "spans"],
      "properties": {
        "chain_id": { "$ref": "#/$defs/chainId" },
        "supports": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/topologySupportRegistry" }
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/topologySpanRegistry" }
        }
      }
    },
    "topologyAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "mode",
        "authorization",
        "privacy",
        "findings",
        "traces",
        "chains"
      ],
      "properties": {
        "policy": { "const": "beam-plan-in-situ/v1" },
        "mode": { "const": "read-only" },
        "authorization": { "const": "topology-never-authorizes-edits" },
        "privacy": { "const": "local-only" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/topologyFinding" }
        },
        "traces": {
          "type": "array",
          "items": { "$ref": "#/$defs/topologyTrace" }
        },
        "chains": {
          "type": "array",
          "items": { "$ref": "#/$defs/topologyChain" }
        }
      }
    }
  }
}
