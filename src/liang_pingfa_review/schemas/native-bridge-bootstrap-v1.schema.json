{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/native-bridge-bootstrap/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "pid",
    "pipe",
    "mode",
    "adapter",
    "plugin",
    "host",
    "process",
    "capabilities",
    "bootstrap",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "liang-pingfa/native-bridge-bootstrap/v1"
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "pipe": {
      "type": "string",
      "pattern": "^\\\\\\\\\\.\\\\pipe\\\\liang-pingfa-native-[A-Za-z0-9_-]{16,128}$"
    },
    "mode": {
      "const": "read_only"
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "plugin": {
      "$ref": "#/$defs/plugin"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "process": {
      "$ref": "#/$defs/process"
    },
    "capabilities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "create_review_marker/v1"
        },
        {
          "const": "read.exact_geometry/v1"
        },
        {
          "const": "read.inventory/v1"
        },
        {
          "const": "translate_dbtext/v1"
        }
      ],
      "items": false
    },
    "bootstrap": {
      "$ref": "#/$defs/bootstrap"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "major",
        "minor"
      ],
      "properties": {
        "version": {
          "const": "liang-pingfa/native-bridge/v1"
        },
        "major": {
          "const": 1
        },
        "minor": {
          "const": 0
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "version"
      ],
      "properties": {
        "id": {
          "const": "liang-pingfa-autocad-adapter"
        },
        "profile": {
          "enum": [
            "autocad2024",
            "autocad2025",
            "autocad2026"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z._-]+$"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "const": "liang-pingfa-autocad-plugin"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z._-]+$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "release",
        "runtime",
        "mode"
      ],
      "properties": {
        "product": {
          "const": "autocad"
        },
        "release": {
          "enum": [
            "2024",
            "2025",
            "2026"
          ]
        },
        "runtime": {
          "enum": [
            "net48",
            "net8",
            "net10"
          ]
        },
        "mode": {
          "const": "full_host"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows_session_id",
        "creation_time_100ns",
        "instance_fingerprint",
        "executable_fingerprint"
      ],
      "properties": {
        "windows_session_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "creation_time_100ns": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,19})$"
        },
        "instance_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "executable_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonce",
        "config_sha256",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "nonce": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
