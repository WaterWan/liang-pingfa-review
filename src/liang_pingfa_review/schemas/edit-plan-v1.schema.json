{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/edit-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "audit_binding",
    "operation_profile",
    "operations",
    "expected_after",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "liang-pingfa/edit-plan/v1" },
    "plan_id": { "$ref": "#/$defs/planId" },
    "created_at": { "$ref": "#/$defs/utcTimestamp" },
    "audit_binding": { "$ref": "#/$defs/auditBinding" },
    "operation_profile": { "const": "auxiliary-overlay-text-delete/v1" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "expected_after": { "$ref": "#/$defs/expectedAfter" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "planId": {
      "type": "string",
      "pattern": "^plan-[0-9a-f]{32}$"
    },
    "auditId": {
      "type": "string",
      "pattern": "^audit-[0-9a-f]{32}$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^finding-[0-9a-f]{24}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^operation-[0-9a-f]{24}$"
    },
    "handle": {
      "type": "string",
      "pattern": "^[0-9A-F]+$"
    },
    "entityType": {
      "enum": ["TEXT", "LINE", "LWPOLYLINE", "INSERT", "DIMENSION", "HATCH"]
    },
    "layout": {
      "enum": ["modelspace", "paperspace", "block"]
    },
    "sourceTopic": {
      "enum": [
        "平面与截面表达、集中与原位作用域",
        "平面与截面综合阅读"
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "auditBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_id",
        "audit_integrity_sha256",
        "source_sha256",
        "source_path_fingerprint",
        "source_file_identity_fingerprint"
      ],
      "properties": {
        "audit_id": { "$ref": "#/$defs/auditId" },
        "audit_integrity_sha256": { "$ref": "#/$defs/sha256" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "source_path_fingerprint": { "$ref": "#/$defs/sha256" },
        "source_file_identity_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "entityTypeCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "count"],
      "properties": {
        "entity_type": { "$ref": "#/$defs/entityType" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "layerCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_fingerprint", "count"],
      "properties": {
        "layer_fingerprint": { "$ref": "#/$defs/sha256" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "layoutCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "count"],
      "properties": {
        "layout": { "$ref": "#/$defs/layout" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "expectedAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_manifest_digest",
        "content_multiset_digest",
        "entity_order_manifest_digest",
        "non_target_manifest_digest",
        "paired_right_panel_digest",
        "bounds_fingerprint",
        "bounds_has_data",
        "layer_manifest_digest",
        "table_style_manifest_digest",
        "header_manifest_digest",
        "raw_header_manifest_digest",
        "objects_manifest_digest",
        "classes_manifest_digest",
        "raw_classes_manifest_digest",
        "raw_classes_multiset_digest",
        "raw_classes_record_count",
        "acdsdata_manifest_digest",
        "raw_section_structure_digest",
        "entity_type_counts",
        "layer_counts",
        "layout_counts"
      ],
      "properties": {
        "full_manifest_digest": { "$ref": "#/$defs/sha256" },
        "content_multiset_digest": { "$ref": "#/$defs/sha256" },
        "entity_order_manifest_digest": { "$ref": "#/$defs/sha256" },
        "non_target_manifest_digest": { "$ref": "#/$defs/sha256" },
        "paired_right_panel_digest": { "$ref": "#/$defs/sha256" },
        "bounds_fingerprint": { "$ref": "#/$defs/sha256" },
        "bounds_has_data": { "type": "boolean" },
        "layer_manifest_digest": { "$ref": "#/$defs/sha256" },
        "table_style_manifest_digest": { "$ref": "#/$defs/sha256" },
        "header_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_header_manifest_digest": { "$ref": "#/$defs/sha256" },
        "objects_manifest_digest": { "$ref": "#/$defs/sha256" },
        "classes_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_classes_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_classes_multiset_digest": { "$ref": "#/$defs/sha256" },
        "raw_classes_record_count": { "type": "integer", "minimum": 0 },
        "acdsdata_manifest_digest": { "$ref": "#/$defs/sha256" },
        "raw_section_structure_digest": { "$ref": "#/$defs/sha256" },
        "entity_type_counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/entityTypeCount" }
        },
        "layer_counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/layerCount" }
        },
        "layout_counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/layoutCount" }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "entity_type",
        "layout",
        "expected_before_fingerprint",
        "expected_before_content_fingerprint"
      ],
      "properties": {
        "handle": { "$ref": "#/$defs/handle" },
        "entity_type": { "const": "TEXT" },
        "layout": { "const": "modelspace" },
        "expected_before_fingerprint": { "$ref": "#/$defs/sha256" },
        "expected_before_content_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_absent",
        "content_fingerprint_delta",
        "no_added_entities",
        "non_target_manifest_preserved",
        "paired_right_panel_preserved",
        "re_audit_overlay_condition_cleared"
      ],
      "properties": {
        "target_absent": { "const": true },
        "content_fingerprint_delta": { "const": -1 },
        "no_added_entities": { "const": true },
        "non_target_manifest_preserved": { "const": true },
        "paired_right_panel_preserved": { "const": true },
        "re_audit_overlay_condition_cleared": { "const": true }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "finding_id",
        "rationale",
        "source_topics",
        "target",
        "expected_postcondition"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/operationId" },
        "kind": { "const": "delete_auxiliary_overlay_text" },
        "finding_id": { "$ref": "#/$defs/findingId" },
        "rationale": { "const": "删除已审计的辅助覆盖文字，不改变设计表达内容。" },
        "source_topics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceTopic" }
        },
        "target": { "$ref": "#/$defs/target" },
        "expected_postcondition": { "$ref": "#/$defs/postcondition" }
      }
    }
  }
}
