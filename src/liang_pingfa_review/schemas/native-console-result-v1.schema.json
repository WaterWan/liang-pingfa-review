{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/native-console-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "manifest_id", "manifest_integrity_sha256", "nonce", "final_revision_fingerprint", "final_revision_transition", "final_document_binding", "transaction", "operation_results", "integrity"],
  "properties": {
    "schema_version": {"const": "liang-pingfa/native-console-result/v1"},
    "run_id": {"$ref": "#/$defs/runId"},
    "manifest_id": {"$ref": "#/$defs/manifestId"},
    "manifest_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "nonce": {"$ref": "#/$defs/nonce"},
    "final_revision_fingerprint": {"$ref": "#/$defs/sha256"},
    "final_revision_transition": {
      "enum": ["save_reopen_changed", "preserved_by_plugin_capability"]
    },
    "final_document_binding": {"$ref": "#/$defs/finalDocumentBinding"},
    "transaction": {"$ref": "#/$defs/transaction"},
    "operation_results": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/operationResult"}},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runId": {"type": "string", "pattern": "^native-run-[a-f0-9]{32}$"},
    "manifestId": {"type": "string", "pattern": "^native-manifest-[a-f0-9]{32}$"},
    "operationId": {"type": "string", "pattern": "^native-operation-[a-f0-9]{24}$"},
    "nonce": {"type": "string", "minLength": 43, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sha256", "byte_size", "path_fingerprint", "file_identity_fingerprint", "dwg_header_signature"],
      "properties": {
        "format": {"const": "DWG"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 0},
        "path_fingerprint": {"$ref": "#/$defs/sha256"},
        "file_identity_fingerprint": {"$ref": "#/$defs/sha256"},
        "dwg_header_signature": {"type": "string", "pattern": "^AC[0-9A-Z]{4}$"}
      }
    },
    "finalDocumentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_instance_fingerprint", "revision_fingerprint", "output_copy_binding"],
      "properties": {
        "database_instance_fingerprint": {"$ref": "#/$defs/sha256"},
        "revision_fingerprint": {"$ref": "#/$defs/sha256"},
        "output_copy_binding": {"$ref": "#/$defs/source"}
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight", "outcome", "rollback"],
      "properties": {
        "preflight": {"enum": ["passed", "failed"]},
        "outcome": {"enum": ["committed", "rolled_back", "not_started"]},
        "rollback": {"enum": ["not_required", "claimed", "failed"]}
      }
    },
    "operationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "status", "postcondition_digest"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/operationId"},
        "status": {"enum": ["applied", "rejected", "rolled_back"]},
        "postcondition_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {"algorithm": {"const": "SHA-256"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
