{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/native-verification/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id",
    "created_at",
    "audit_binding",
    "plan_binding",
    "runtime_package_fingerprint",
    "output_binding",
    "transition_digest",
    "operation_results",
    "record_cardinality",
    "passed",
    "non_claims",
    "integrity",
    "manifest_binding",
    "console_result_binding",
    "console_export_binding"
  ],
  "properties": {
    "schema_version": {
      "const": "liang-pingfa/native-verification/v2"
    },
    "verification_id": {
      "$ref": "#/$defs/verificationId"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "audit_binding": {
      "$ref": "#/$defs/auditBinding"
    },
    "plan_binding": {
      "$ref": "#/$defs/planBinding"
    },
    "runtime_package_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "output_binding": {
      "$ref": "#/$defs/outputBinding"
    },
    "transition_digest": {
      "$ref": "#/$defs/sha256"
    },
    "operation_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/operationResult"
      }
    },
    "record_cardinality": {
      "const": "explicit_private"
    },
    "passed": {
      "const": true
    },
    "non_claims": {
      "$ref": "#/$defs/nonClaims"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "manifest_binding": {
      "$ref": "#/$defs/manifestBinding"
    },
    "console_result_binding": {
      "$ref": "#/$defs/consoleResultBinding"
    },
    "console_export_binding": {
      "$ref": "#/$defs/consoleExportBinding"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "verificationId": {
      "type": "string",
      "pattern": "^native-verification-[a-f0-9]{32}$"
    },
    "auditId": {
      "type": "string",
      "pattern": "^native-audit-[a-f0-9]{32}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^native-plan-[a-f0-9]{32}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^native-operation-[a-f0-9]{24}$"
    },
    "auditBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_id",
        "audit_integrity_sha256",
        "audit_schema_version"
      ],
      "properties": {
        "audit_id": {
          "$ref": "#/$defs/auditId"
        },
        "audit_integrity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audit_schema_version": {
          "const": "liang-pingfa/native-audit/v2"
        }
      }
    },
    "planBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "plan_integrity_sha256",
        "plan_schema_version"
      ],
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/planId"
        },
        "plan_integrity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan_schema_version": {
          "const": "liang-pingfa/native-edit-plan/v2"
        }
      }
    },
    "outputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sha256",
        "byte_size",
        "path_fingerprint",
        "file_identity_fingerprint",
        "dwg_header_signature",
        "verified_at"
      ],
      "properties": {
        "format": {
          "const": "DWG"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "path_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "file_identity_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "dwg_header_signature": {
          "type": "string",
          "pattern": "^AC[0-9A-Z]{4}$"
        },
        "verified_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "operationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "verified",
        "marker_handle"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/operationId"
        },
        "kind": {
          "enum": [
            "translate_dbtext",
            "delete_auxiliary_overlay_text",
            "create_review_marker"
          ]
        },
        "verified": {
          "const": true
        },
        "marker_handle": {
          "oneOf": [
            {
              "$ref": "#/$defs/handle"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "nonClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_only",
        "external_transaction_claim_unproven",
        "real_host_integration_unproven"
      ],
      "properties": {
        "evidence_only": {
          "const": true
        },
        "external_transaction_claim_unproven": {
          "const": true
        },
        "real_host_integration_unproven": {
          "const": true
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "manifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_integrity_sha256",
        "manifest_schema_version"
      ],
      "properties": {
        "manifest_id": {
          "$ref": "#/$defs/manifestId"
        },
        "manifest_integrity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_schema_version": {
          "const": "liang-pingfa/native-edit-manifest/v2"
        }
      }
    },
    "consoleResultBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "result_integrity_sha256",
        "result_schema_version"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "result_integrity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_schema_version": {
          "const": "liang-pingfa/native-console-result/v2"
        }
      }
    },
    "consoleExportBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "export_integrity_sha256",
        "export_schema_version"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "export_integrity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "export_schema_version": {
          "const": "liang-pingfa/native-console-export/v2"
        }
      }
    },
    "manifestId": {
      "type": "string",
      "pattern": "^native-manifest-[a-f0-9]{32}$"
    },
    "handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[0-9A-F]+$"
    },
    "runId": {
      "type": "string",
      "pattern": "^native-run-[a-f0-9]{32}$"
    }
  }
}
