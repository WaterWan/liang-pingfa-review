{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/native-audit/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "created_at", "expires_at", "scope", "source", "adapter_binding", "host_executable_fingerprint", "native_host_binding", "session_binding_digest", "geometry_document_binding_digest", "document_binding", "protected_state_digest", "marker_prerequisites", "marker_policy_binding", "records", "findings", "record_cardinality", "integrity"],
  "properties": {
    "schema_version": {"const": "liang-pingfa/native-audit/v1"},
    "audit_id": {"$ref": "#/$defs/auditId"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "scope": {"const": "native-representation-and-readability-only"},
    "source": {"$ref": "#/$defs/source"},
    "adapter_binding": {"$ref": "#/$defs/adapterBinding"},
    "host_executable_fingerprint": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"const": "unavailable"}]},
    "native_host_binding": {"$ref": "#/$defs/sha256"},
    "session_binding_digest": {"$ref": "#/$defs/sha256"},
    "geometry_document_binding_digest": {"$ref": "#/$defs/sha256"},
    "document_binding": {"$ref": "#/$defs/documentBinding"},
    "protected_state_digest": {"$ref": "#/$defs/sha256"},
    "marker_prerequisites": {"$ref": "#/$defs/markerPrerequisites"},
    "marker_policy_binding": {"$ref": "#/$defs/markerPolicyBinding"},
    "records": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/record"}},
    "findings": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/finding"}},
    "record_cardinality": {"const": "explicit_private"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "auditId": {"type": "string", "pattern": "^native-audit-[a-f0-9]{32}$"},
    "targetId": {"type": "string", "pattern": "^native-target-[a-f0-9]{24}$"},
    "findingId": {"type": "string", "pattern": "^native-finding-[a-f0-9]{24}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sha256", "byte_size", "path_fingerprint", "file_identity_fingerprint", "dwg_header_signature"],
      "properties": {
        "format": {"const": "DWG"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 0},
        "path_fingerprint": {"$ref": "#/$defs/sha256"},
        "file_identity_fingerprint": {"$ref": "#/$defs/sha256"},
        "dwg_header_signature": {"type": "string", "pattern": "^AC[0-9A-Z]{4}$"}
      }
    },
    "adapterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_profile", "adapter_version", "plugin_id", "plugin_version", "plugin_fingerprint", "protocol_major", "protocol_minor", "capabilities_digest"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "adapter_profile": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z._-]+$"},
        "plugin_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "plugin_version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z._-]+$"},
        "plugin_fingerprint": {"$ref": "#/$defs/sha256"},
        "protocol_major": {"const": 1},
        "protocol_minor": {"const": 0},
        "capabilities_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "documentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_instance_fingerprint", "revision_fingerprint", "ordered_entity_digest", "container_order_digest", "complete_geometry_digest", "protected_state_digest", "protected_order_digest", "table_state_digest", "layout_state_digest", "block_state_digest", "document_state_digest"],
      "properties": {
        "database_instance_fingerprint": {"$ref": "#/$defs/sha256"},
        "revision_fingerprint": {"$ref": "#/$defs/sha256"},
        "ordered_entity_digest": {"$ref": "#/$defs/sha256"},
        "container_order_digest": {"$ref": "#/$defs/sha256"},
        "complete_geometry_digest": {"$ref": "#/$defs/sha256"},
        "protected_state_digest": {"$ref": "#/$defs/sha256"},
        "protected_order_digest": {"$ref": "#/$defs/sha256"},
        "table_state_digest": {"$ref": "#/$defs/sha256"},
        "layout_state_digest": {"$ref": "#/$defs/sha256"},
        "block_state_digest": {"$ref": "#/$defs/sha256"},
        "document_state_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "markerPrerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_fingerprint", "style_fingerprint"],
      "properties": {
        "layer_fingerprint": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "style_fingerprint": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "markerPolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "profile", "profile_enabled", "enabled", "plugin_capability", "layer", "style", "layer_fingerprint", "style_fingerprint", "height_bits", "rotation_bits", "text_prefix", "text_derivation_version", "geometry_defaults"],
      "properties": {
        "policy_version": {"const": "marker-policy/v1"},
        "profile": {"const": "create_review_marker/v1"},
        "profile_enabled": {"type": "boolean"},
        "enabled": {"type": "boolean"},
        "plugin_capability": {"type": "boolean"},
        "layer": {"type": "string", "minLength": 1, "maxLength": 255},
        "style": {"type": "string", "minLength": 1, "maxLength": 255},
        "layer_fingerprint": {"$ref": "#/$defs/sha256"},
        "style_fingerprint": {"$ref": "#/$defs/sha256"},
        "height_bits": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "rotation_bits": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "text_prefix": {"const": "LPF-REVIEW-"},
        "text_derivation_version": {"const": "operation-id-suffix/v1"},
        "geometry_defaults": {"$ref": "#/$defs/markerGeometryDefaults"}
      }
    },
    "markerGeometryDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space_kind", "block_path", "overlay_evidence"],
      "properties": {
        "space_kind": {"const": "modelspace"},
        "block_path": {"type": "array", "maxItems": 0, "items": false},
        "overlay_evidence": {"$ref": "#/$defs/markerOverlayEvidence"}
      }
    },
    "markerOverlayEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unique_content", "left_panel", "corresponding_right_absent", "visible_interference", "unsupported_data"],
      "properties": {
        "unique_content": {"const": false},
        "left_panel": {"const": false},
        "corresponding_right_absent": {"const": false},
        "visible_interference": {"const": false},
        "unsupported_data": {"const": true}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "native_type", "before_geometry_fingerprint", "opaque_state_digest", "eligible_profiles"],
      "properties": {
        "target_id": {"$ref": "#/$defs/targetId"},
        "native_type": {"enum": ["DBTEXT", "LINE", "LWPOLYLINE", "OPAQUE"]},
        "before_geometry_fingerprint": {"$ref": "#/$defs/sha256"},
        "opaque_state_digest": {"$ref": "#/$defs/sha256"},
        "eligible_profiles": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["translate_dbtext/v1", "delete_auxiliary_overlay_text/v1"]}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "status", "actionability", "target_id", "profile"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/findingId"},
        "status": {"enum": ["actionable", "read_only", "insufficient_evidence"]},
        "actionability": {"type": "boolean"},
        "target_id": {"oneOf": [{"$ref": "#/$defs/targetId"}, {"type": "null"}]},
        "profile": {"oneOf": [{"enum": ["translate_dbtext/v1", "delete_auxiliary_overlay_text/v1"]}, {"type": "null"}]}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {"algorithm": {"const": "SHA-256"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
