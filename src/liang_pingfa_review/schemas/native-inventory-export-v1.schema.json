{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liang-pingfa/native-inventory-export/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_revision_fingerprint", "inventory_digest"],
  "properties": {
    "document_revision_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventory_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
